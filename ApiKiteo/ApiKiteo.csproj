<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApiKiteo.API</RootNamespace>
    <AssemblyName>ApiKiteo.API</AssemblyName>
    <UserSecretsId>api-kiteo-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Data access -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />
	
	<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
	
	<PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="3.6.0" />
    <!-- LDAP authentication -->
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.0" />

    <!-- Swagger / OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />

    <!-- User Secrets (desarrollo) -->
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />

    <!-- Logging a archivo con rolling diario y auto-borrado -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include=".config\" />
  </ItemGroup>

</Project>
