     "DescanBuscar":    "Kit_vin_descan_buscar",
     "DescaneoAplicar": "Kit_vin_descaneo_aplicar"


  },
  "CacheSettings": {

    // ── SemanasRetener ───────────────────────────────────────────────────────
    // Cuántas semanas hacia atrás se conservan en Kit_vin_wks_status_cache.
    // Entradas con updated_at más antiguo que este límite se eliminan
    // automáticamente después de cada escaneo/entrega/crear_db.
    //
    // Impacto: valor más alto = más historial en el pizarrón,
    //          valor más bajo = tabla más pequeña, queries más rápidos.
    //
    // Rango válido: 1–52 (semanas).
    // Default: 8 (dos meses de historial activo).
    "SemanasRetener": 8,

    // ── HorasCompletadas ─────────────────────────────────────────────────────
    // Cuántas horas esperar antes de eliminar una semana que ya llegó al 100%
    // (KitsCompTot >= VinCant). El margen existe por si hay ajustes de
    // último momento después de completar la semana.
    //
    // Impacto: valor más alto = semanas completas permanecen más tiempo visibles
    //          en el pizarrón; valor más bajo = se limpian antes.
    //
    // Rango válido: 1–8760 (1 hora a 1 año).
    // Default: 48 (2 días de margen post-completado).
    "HorasCompletadas": 48
  },
  "LdapOptions": {
    "Domain": "STCLAIRTECH"
  },
  "DatabaseOverride": "DevTest"
}