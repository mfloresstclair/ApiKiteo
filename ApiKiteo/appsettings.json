    "GetSemanaVinStatus": "Kit_vin_Wk_Vin_Status",
    "GetVinToAdjust": "Kit_vin_to_adjust",
    "EscanearAjuste": "Kit_vin_Scan_Ajuste",
    "Escanear": "Kit_vin_Scan",
    "EntregarVines": "Kit_vin_entregado_final",
    "AprobarSemana": "Kit_vin_wk_approve",
    "GetAdminRolesList": "Kit_vin_admin_roles_list",
    "AdminRoleAdd": "Kit_vin_admin_role_add",
